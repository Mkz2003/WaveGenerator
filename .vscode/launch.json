{
    "configurations": [
        {
            "name": "CMSIS-DAP Debug (G0) (Debug Only --Release)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "serverpath": "openocd",
            "configFiles": [
                "${workspaceFolder}/openocd.cfg"
            ],
            "executable": "${workspaceFolder}/build/Release/${workspaceFolderBasename}.elf",
            "device": "STM32G071xx",
            "svdPath": "${workspaceFolder}/STM32G071.svd"
        },
        {
            "name": "OpenOCD Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "e:\\Program\\WaveGenerator\\build\\Release\\WaveGenerator.elf",
            "svdPath": "e:\\Program\\WaveGenerator\\STM32G071.svd",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb-multiarch",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Set remote target to port 3333",
                    "text": "target remote :3333",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}